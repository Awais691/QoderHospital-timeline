{
  "name": "carewell-hospital",
  "version": "1.0.0",
  "private": true,
  "description": "CareWell Hospital — a multi-page static hospital website demo.",
  "scripts": {
    "build:css": "tailwindcss -c config/tailwind.config.js -i ./assets/css/input.css -o ./assets/css/custom.css --minify",
    "watch:css": "tailwindcss -c config/tailwind.config.js -i ./assets/css/input.css -o ./assets/css/custom.css --watch",
    "serve": "npx --yes http-server . -p 4173 -c-1"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "tailwindcss": "3.4.17"
  }
}
